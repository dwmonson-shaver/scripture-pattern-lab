{
  "name": "scripture-pattern-lab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for scripture-pattern-lab. Nuxt 3 + Vuetify 3 + TypeScript, deployed to Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:docs",
    "dev": "nuxt dev",
    "generate:docs": "node scripts/collect-docs.mjs",
    "prebuild": "npm run generate:docs",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "gen:types": "openapi-typescript $NUXT_BACKEND_URL/openapi.json -o types/backend.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dryrun": "npm run build && wrangler deploy --dry-run --outdir=dist",
    "cf-typegen": "wrangler types",
    "pretest": "npm run generate:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "check:no-llm-sdk": "node scripts/check-no-llm-sdk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.1",
    "@mdi/font": "^7.4.47",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13",
    "vuetify": "^3.7.6",
    "vuetify-nuxt-module": "^0.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@nuxt/eslint": "^0.7.4",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^15.11.7",
    "markdown-it": "^14.3.0",
    "nitro-cloudflare-dev": "^0.2.1",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
